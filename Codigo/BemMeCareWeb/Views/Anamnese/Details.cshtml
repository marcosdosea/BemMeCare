@model BemMeCareWeb.Models.ProfissionalServicoViewModel

@{
    ViewData["Title"] = "Detalhes da anamnese";
}

<h1>Detalhes da anamnese</h1>

<div>
    <h4>Anamnese</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FormAnamnese)
        </dt>
        <dd class="col-sm-10">
            @if (string.IsNullOrWhiteSpace(Model.FormAnamnese))
            {
                <span>Este serviço ainda não possui anamnese cadastrada.</span>
            }
            else
            {
                @Html.DisplayFor(model => model.FormAnamnese)
                @if (Model.FormAnamnese.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
                     Model.FormAnamnese.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
                {
                    <a href="@Model.FormAnamnese" target="_blank" rel="noopener noreferrer" class="btn btn-bmc-medio">Abrir</a>
                }
            }
        </dd>
    </dl>
</div>
<div>
    @if (string.IsNullOrWhiteSpace(Model.FormAnamnese))
    {
        <a asp-action="Create" asp-route-idProfissional="@Model.IdProfissional" asp-route-idServico="@Model.IdServico" class="btn btn-bmc-medio">Adicionar</a>
    }
    else
    {
        <a asp-action="Create" asp-route-idProfissional="@Model.IdProfissional" asp-route-idServico="@Model.IdServico" class="btn btn-bmc-medio">Editar</a>
        <span></span>
        <a asp-action="Delete" asp-route-idProfissional="@Model.IdProfissional" asp-route-idServico="@Model.IdServico" class="btn btn-bmc-medio">Remover</a>
        <span></span>
    }
    <a asp-action="Index" asp-route-idProfissional="@Model.IdProfissional" class="btn btn-bmc-medio">Voltar</a>
</div>