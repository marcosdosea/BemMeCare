@model BemMeCareWeb.Models.CategoriaViewModel

@{
    ViewData["Title"] = "Visualizar categoria";
}

<h1>Visualizar categoria</h1>

<div class="col-md-4">
    <div class="form-group">
        <label asp-for="Nome" class="control-label"></label>
        <input asp-for="Nome" class="form-control" size="45" disabled/>
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
</div>
<div class="form-group position-fixed end-0 p-3 d-flex gap-2" style="bottom: 60px;">
    <a asp-action="Index" class="btn btn-bmc-medio">Voltar</a>
</div>
