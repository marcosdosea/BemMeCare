@model BemMeCareWeb.Models.CategoriaViewModel

@{
    ViewData["Title"] = "Adicionar categoria";
}

<h1>Adicionar categoria</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" size="45" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group position-fixed end-0 p-3 d-flex gap-2" style="bottom: 60px;">
                <a asp-action="Index" class="btn btn-bmc-medio">Cancelar</a>
                <input type="submit" value="Adicionar" class="btn btn-bmc-medio" />
            </div>
        </form>
    </div>
</div>
