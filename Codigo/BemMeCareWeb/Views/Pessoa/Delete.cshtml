@model BemMeCareWeb.Models.PessoaViewModel

@{
    ViewData["Title"] = "Deletar pessoa";
}

<h1>Deletar pessoa</h1>

<h3>Tem certeza que quer deletar essa pessoa?</h3>
<div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Nome" class="control-label"></label>
            <input asp-for="Nome" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Email" class="control-label"></label>
            <input asp-for="Email" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Cpf" class="control-label"></label>
            <input asp-for="Cpf" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Telefone" class="control-label"></label>
            <input asp-for="Telefone" class="form-control" disabled />
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="form-group position-fixed end-0 p-3 d-flex gap-2" style="bottom: 60px;">
                <a asp-action="Index" class="btn btn-bmc-medio">Cancelar</a>
                <input type="submit" value="Deletar" class="btn btn-bmc-medio" />
            </div>
        </form>
    </div>
</div>
