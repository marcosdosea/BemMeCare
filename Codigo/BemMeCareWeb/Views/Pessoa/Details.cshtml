@model BemMeCareWeb.Models.PessoaViewModel

@{
    ViewData["Title"] = "Visualizar pessoa";
}

<h1>Visualizar pessoa</h1>

<div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Nome" class="control-label"></label>
            <input asp-for="Nome" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Email" class="control-label"></label>
            <input asp-for="Email" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Cpf" class="control-label"></label>
            <input asp-for="Cpf" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Telefone" class="control-label"></label>
            <input asp-for="Telefone" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="DataDeNascimento" class="control-label"></label>
            <input asp-for="DataDeNascimento" class="form-control" type="date" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Cor" class="control-label"></label>
            <input asp-for="Cor" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Genero" class="control-label"></label>
            <input asp-for="Genero" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Sexualidade" class="control-label"></label>
            <input asp-for="Sexualidade" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Cep" class="control-label"></label>
            <input asp-for="Cep" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Rua" class="control-label"></label>
            <input asp-for="Rua" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Numero" class="control-label"></label>
            <input asp-for="Numero" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Complemento" class="control-label"></label>
            <input asp-for="Complemento" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Bairro" class="control-label"></label>
            <input asp-for="Bairro" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Cidade" class="control-label"></label>
            <input asp-for="Cidade" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Estado" class="control-label"></label>
            <input asp-for="Estado" class="form-control" disabled />
        </div>
    </div>
</div>

<div class="form-group position-fixed end-0 p-3 d-flex gap-2" style="bottom: 60px;">
    <a asp-action="Index" class="btn btn-bmc-medio">Voltar</a>
</div>
