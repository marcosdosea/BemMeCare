@model BemMeCareWeb.Models.ServicoViewModel

@{
    ViewData["Title"] = "Cadastrar serviço";
}

<h1>Cadastrar serviço</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdCategoria" class="control-label"></label>
                <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-control">
                    <option value="">-- Selecione uma categoria --</option>
                </select>
                <span asp-validation-for="IdCategoria" class="text-danger"></span>
            </div>

            <div class="form-group position-fixed end-0 p-3 d-flex gap-2" style="bottom: 60px;">
                <a asp-action="Index" class="btn btn-bmc-medio">Cancelar</a>
                <input type="submit" value="Cadastrar" class="btn btn-bmc-medio" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
