@model BemMeCareWeb.Models.ServicoViewModel

@{
    ViewData["Title"] = "Deletar serviço";
}

<h1>Deletar serviço</h1>

<h3>Tem certeza que quer deletar esse serviço?</h3>
<div>
    <div class="col-md-4">
        <div class="form-group">
            <label asp-for="Id" class="control-label"></label>
            <input asp-for="Id" class="form-control" disabled />
        </div>
        <div class="form-group">
            <label asp-for="Nome" class="control-label"></label>
            <input asp-for="Nome" class="form-control" size="45" disabled />
        </div>
        <div class="form-group">
            <label asp-for="IdCategoria" class="control-label"></label>
            <input asp-for="IdCategoria" class="form-control" disabled />
        </div>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="form-group position-fixed end-0 p-3 d-flex gap-2" style="bottom: 60px;">
                <a asp-action="Index" class="btn btn-bmc-medio">Cancelar</a>
                <input type="submit" value="Deletar" class="btn btn-bmc-medio" />
            </div>
        </form>
    </div>
</div>
