@model BemMeCareWeb.Models.ProfissionalViewModel

@{
    ViewData["Title"] = "Visualizar profissional";
}

<h1>@Model.Nome</h1>

<div class="col-md-4">
    <div class="form-group">
        <label asp-for="EstaAtivo" class="control-label"></label>
        <input type="text" class="form-control" value="@(Model.EstaAtivo == 1 ? "Ativo" : "Inativo")" disabled />
    </div>
    <div class="form-group">
        <label asp-for="Cpf" class="control-label"></label>
        <input asp-for="Cpf" class="form-control" disabled />
    </div>
    <div class="form-group">
        <label asp-for="ChavePix" class="control-label"></label>
        <input asp-for="ChavePix" class="form-control" disabled />
    </div>
    <div class="form-group">
        <label asp-for="Categorias" class="control-label"></label>
        <input type="text" class="form-control" value="@string.Join(", ", Model.Categorias.Select(c => c.Nome))" disabled />
    </div>
    <div class="form-group">
        <label asp-for="Servicos" class="control-label"></label>
        <input type="text" class="form-control" value="@string.Join(", ", Model.Servicos.Select(s => s.Nome))" disabled />
    </div>

    <label class="control-label">Configurações adicionais</label>
    <div class="form-group form-check">
        <input class="form-check-input" type="checkbox" checked="@(Model.GerirHorario == 1)" disabled />
        <label class="form-check-label">@Html.DisplayNameFor(model => model.GerirHorario)</label>
    </div>
    <div class="form-group form-check">
        <input class="form-check-input" type="checkbox" checked="@(Model.GerirServico == 1)" disabled />
        <label class="form-check-label">@Html.DisplayNameFor(model => model.GerirServico)</label>
    </div>
    <div class="form-group form-check">
        <input class="form-check-input" type="checkbox" checked="@(Model.ReceberPagamentoDireto == 1)" disabled />
        <label class="form-check-label">@Html.DisplayNameFor(model => model.ReceberPagamentoDireto)</label>
    </div>
</div>

<div class="form-group position-fixed end-0 p-3 d-flex gap-2" style="bottom: 60px;">
    <a asp-action="Index" class="btn btn-bmc-medio">Voltar</a>
    <a asp-action="Edit" asp-route-id="@Model.IdPessoa" class="btn btn-bmc-medio">Editar dados</a>
    <a asp-action="Delete" asp-route-id="@Model.IdPessoa" class="btn btn-bmc-medio">Excluir dados</a>
</div>