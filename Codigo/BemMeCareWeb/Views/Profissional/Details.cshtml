@model BemMeCareWeb.Models.ProfissionalViewModel

@{
    ViewData["Title"] = "Visualizar profissional";
}

<h1>Profissionais</h1>

<div>
    <div class="d-flex gap-4 align-items-start mb-4">
        <div class="border rounded d-flex align-items-center justify-content-center text-muted"
             style="width: 180px; height: 130px;">
            <span>Sem foto</span>
        </div>
        <div class="d-flex flex-column align-items-start gap-2">
            <h2 class="h4 mb-1">@Model.Nome</h2>
            <a asp-action="Edit" asp-route-id="@Model.IdPessoa" class="btn btn-bmc-medio">Editar dados</a>
            <span class="btn btn-bmc-medio disabled" aria-disabled="true">
                Status: @(Model.EstaAtivo == 1 ? "Ativo" : "Inativo")
            </span>
            <a asp-controller="Horario" asp-action="Index" asp-route-idProfissional="@Model.IdPessoa"
               class="btn btn-bmc-medio">Expediente</a>
            <a asp-controller="Anamnese" asp-action="Index" asp-route-idProfissional="@Model.IdPessoa"
               class="btn btn-bmc-medio">Serviços</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Cpf" class="control-label"></label>
            <input asp-for="Cpf" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="ChavePix" class="control-label"></label>
            <input asp-for="ChavePix" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Categorias" class="control-label"></label>
            <input type="text" class="form-control"
                   value="@string.Join(", ", Model.Categorias.Select(c => c.Nome))" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Servicos" class="control-label"></label>
            <input type="text" class="form-control"
                   value="@string.Join(", ", Model.Servicos.Select(s => s.Nome))" disabled />
        </div>

        <label class="control-label">Configurações adicionais</label>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chkGerirHorario"
                   checked="@(Model.GerirHorario == 1)" disabled />
            <label class="form-check-label" for="chkGerirHorario">@Html.DisplayNameFor(m => m.GerirHorario)</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chkGerirServico"
                   checked="@(Model.GerirServico == 1)" disabled />
            <label class="form-check-label" for="chkGerirServico">@Html.DisplayNameFor(m => m.GerirServico)</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="chkReceberPagamento"
                   checked="@(Model.ReceberPagamentoDireto == 1)" disabled />
            <label class="form-check-label" for="chkReceberPagamento">@Html.DisplayNameFor(m => m.ReceberPagamentoDireto)</label>
        </div>
    </div>
</div>

<div class="form-group position-fixed end-0 p-3 d-flex gap-2" style="bottom: 60px;">
    <a asp-action="Index" class="btn btn-bmc-medio">Voltar</a>
    <a asp-action="Delete" asp-route-id="@Model.IdPessoa" class="btn btn-bmc-medio">Excluir dados</a>
</div>