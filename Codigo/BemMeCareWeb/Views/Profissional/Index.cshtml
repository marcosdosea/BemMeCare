@model IEnumerable<BemMeCareWeb.Models.ProfissionalViewModel>

@{
    ViewData["Title"] = "Profissionais";
}

<h1>Profissionais</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Adicionar profissional</a>
</p>

<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">Filtro rápido</label>
            <input type="text" id="filtroRapido" class="form-control" onkeyup="filtrarTabela()" />
        </div>
    </div>
</div>

<table class="table" id="tabelaProfissionais">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EstaAtivo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Servicos)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(item.EstaAtivo == 1 ? "Ativo" : "Inativo")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Servicos)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.IdPessoa">Acessar</a>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
    <script>
        function filtrarTabela() {
            var filtro = document.getElementById("filtroRapido").value.toLowerCase();
            var linhas = document.querySelectorAll("#tabelaProfissionais tbody tr");
            linhas.forEach(function (linha) {
                var texto = linha.innerText.toLowerCase();
                linha.style.display = texto.indexOf(filtro) > -1 ? "" : "none";
            });
        }
    </script>
}
