@model BemMeCareWeb.Models.ProfissionalViewModel

@{
    ViewData["Title"] = "Editar dados";
}

<h1>Profissionais</h1>

<h4>@Html.DisplayFor(model => model.Nome)</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="IdPessoa" />
            <input type="hidden" asp-for="IdEstabelecimento" />
            <input type="hidden" asp-for="DuracaoIntervaloTempo" />
            <input type="hidden" asp-for="EstaAtivo" />
            <input type="hidden" asp-for="EProfissional" />
            <input type="hidden" asp-for="EAtendente" />

            <div class="form-group">
                <label asp-for="Cpf" class="control-label"></label>
                <input asp-for="Cpf" class="form-control" placeholder="000.000.000-00" readonly />
                <span asp-validation-for="Cpf" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ChavePix" class="control-label"></label>
                <input asp-for="ChavePix" class="form-control" placeholder="emailpix@exemplo.com" />
                <span asp-validation-for="ChavePix" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Categoria(s)</label>
                <select class="form-control">
                    <option value="">Selecione...</option>
                </select>
            </div>

            <div class="form-group">
                <label class="control-label">Serviços</label>
                <select class="form-control">
                    <option value="">Selecione...</option>
                </select>
            </div>

            <h4>Configurações adicionais</h4>

            <div class="form-group form-check">
                <input type="hidden" asp-for="GerirHorario" id="GerirHorario" />
                <input type="checkbox" class="form-check-input" id="chkGerirHorario"
                       @(Model?.GerirHorario == 1 ? "checked" : "")
                       onchange="document.getElementById('GerirHorario').value = this.checked ? 1 : 0" />
                <label class="form-check-label" for="chkGerirHorario">
                    Profissional pode gerir o seu horário
                </label>
                <span asp-validation-for="GerirHorario" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input type="hidden" asp-for="GerirServico" id="GerirServico" />
                <input type="checkbox" class="form-check-input" id="chkGerirServico"
                       @(Model?.GerirServico == 1 ? "checked" : "")
                       onchange="document.getElementById('GerirServico').value = this.checked ? 1 : 0" />
                <label class="form-check-label" for="chkGerirServico">
                    Profissional pode gerir seus serviços
                </label>
                <span asp-validation-for="GerirServico" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input type="hidden" asp-for="ReceberPagamentoDireto" id="ReceberPagamentoDireto" />
                <input type="checkbox" class="form-check-input" id="chkReceberPagamento"
                       @(Model?.ReceberPagamentoDireto == 1 ? "checked" : "")
                       onchange="document.getElementById('ReceberPagamentoDireto').value = this.checked ? 1 : 0" />
                <label class="form-check-label" for="chkReceberPagamento">
                    Profissional recebe o pagamento do sinal
                </label>
                <span asp-validation-for="ReceberPagamentoDireto" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Confirmar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}