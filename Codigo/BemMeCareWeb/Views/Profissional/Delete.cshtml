@model BemMeCareWeb.Models.ProfissionalViewModel

@{
    ViewData["Title"] = "Profissionais";
}

<h1>Profissionais</h1>

<h3>Para apagar os dados de @Html.DisplayFor(model => model.Nome) digite o CPF dele abaixo:</h3>
<div>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Delete">
                <input type="hidden" asp-for="IdPessoa" />
                <input type="hidden" asp-for="IdEstabelecimento" />

                <div class="form-group">
                    <label asp-for="Cpf" class="control-label"></label>
                    <input asp-for="Cpf" class="form-control" placeholder="000.000.000-00" />
                </div>

                <div class="form-group form-check">
                    <input type="checkbox" class="form-check-input" id="chkCiencia"
                           onchange="document.getElementById('btnApagar').disabled = !this.checked" />
                    <label class="form-check-label" for="chkCiencia">
                        Estou ciente que realizar esta ação apagará a relação entre o profissional e o estabelecimento.
                    </label>
                </div>

                <input type="submit" id="btnApagar" value="Apagar" class="btn btn-danger" disabled /> |
                <a asp-action="Index">Voltar</a>
            </form>
        </div>
    </div>
</div>
