@model BemMeCareWeb.Models.ProfissionalViewModel

@{
    ViewData["Title"] = "Remover profissional";
}

<h1>Remover profissional</h1>

<h3>Tem certeza que quer remover @Model.Nome?</h3>

<div class="col-md-4">
    <div class="form-group">
        <label asp-for="Cpf" class="control-label"></label>
        <input asp-for="Cpf" class="form-control" disabled />
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdPessoa" />
        <div class="form-group form-check">
            <input class="form-check-input" type="checkbox" id="chkCiencia"
                   onchange="document.getElementById('btnApagar').disabled = !this.checked" />
            <label class="form-check-label" for="chkCiencia">
                Estou ciente que realizar esta ação apagará a relação entre o profissional e o estabelecimento.
            </label>
        </div>
        <div class="form-group position-fixed end-0 p-3 d-flex gap-2" style="bottom: 60px;">
            <a asp-action="Details" asp-route-id="@Model.IdPessoa" class="btn btn-bmc-medio">Voltar</a>
            <input type="submit" id="btnApagar" value="Apagar" class="btn btn-bmc-medio" disabled />
        </div>
    </form>
</div>
