@model BemMeCareWeb.Models.AgendamentoDeClientesViewModel

<h1>Resumo do agendamento</h1>

<dl class="row">
    <dt class="col-sm-3">Serviço</dt>
    <dd class="col-sm-9">@Model.NomesServicos</dd>

    <dt class="col-sm-3">Profissional</dt>
    <dd class="col-sm-9">@Model.NomeProfissional</dd>

    <dt class="col-sm-3">Data e horário</dt>
    <dd class="col-sm-9">@Model.DataHoraAtendimento?.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Duração</dt>
    <dd class="col-sm-9">@Model.DuracaoMinutos minutos</dd>

    <dt class="col-sm-3">Preço</dt>
    <dd class="col-sm-9">@Model.PrecoFinal.ToString("C")</dd>
</dl>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="IdProfissional" />
    <input type="hidden" asp-for="IdsServicos" name="IdsServicos" value="@Model.IdsServicos.Single()" />
    <input type="hidden" asp-for="DataHoraAtendimento" />

    <div class="mb-3">
        <label asp-for="NomeCliente" class="form-label"></label>
        <input asp-for="NomeCliente" class="form-control" />
        <span asp-validation-for="NomeCliente" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TelefoneCliente" class="form-label"></label>
        <input asp-for="TelefoneCliente" class="form-control" />
        <span asp-validation-for="TelefoneCliente" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Confirmar</button>
    <a asp-action="Create" class="btn btn-secondary">Voltar</a>
</form>

<partial name="_ValidationScriptsPartial" />
