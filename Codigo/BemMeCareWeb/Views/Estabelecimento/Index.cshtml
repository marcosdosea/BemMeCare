@model IEnumerable<BemMeCareWeb.Models.EstabelecimentoViewModel>

@{
    ViewData["Title"] = "Estabelecimentos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/listagem.css" asp-append-version="true" />
}

<h1>Estabelecimentos</h1>

<div style="width: 75%; margin: auto;">
    <p class="text-end">
        <a asp-action="Create"
           class="btn rounded-pill shadow-sm px-4 py-2 btn-bmc-grande">
            Adicionar Estabelecimento
        </a>
    </p>
    <table>
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nome)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Cnpj)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contato)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Modalidade)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nome)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Cnpj)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Contato)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Modalidade)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>