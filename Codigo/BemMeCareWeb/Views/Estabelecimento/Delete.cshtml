@model BemMeCareWeb.Models.EstabelecimentoViewModel

@{
    ViewData["Title"] = "Deletar estabelecimento";
}

<h1>Deletar estabelecimento</h1>

<h3>Tem certeza que quer deletar esse estabelecimento?</h3>
<div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Nome" class="control-label"></label>
            <input asp-for="Nome" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Cnpj" class="control-label"></label>
            <input asp-for="Cnpj" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Contato" class="control-label"></label>
            <input asp-for="Contato" class="form-control" disabled />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Modalidade" class="control-label"></label>
            <input asp-for="Modalidade" class="form-control" disabled />
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="form-group position-fixed end-0 p-3 d-flex gap-2" style="bottom: 60px;">
                <a asp-action="Index" class="btn btn-bmc-medio">Cancelar</a>
                <input type="submit" value="Deletar" class="btn btn-bmc-medio" />
            </div>
        </form>
    </div>
</div>